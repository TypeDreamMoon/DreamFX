// Phase 1 vertical slice: module calls with literal inputs, plus one sprite renderer.
//
// Everything here is deliberately inside the Phase 1 feature set -- no linked parameters, no enums,
// no dynamic inputs, no user parameters. Those arrive in later phases and this file grows with them.
//
// Build it with:
//   UnrealEditor-Cmd.exe DevTest.uproject -run=DreamFX -unattended -nopause -nosplash
System(Name="Samples/NS_DreamFXPhase1", Root="Plugin.DreamFX")
{
    Emitter Sparks
    {
        EmitterUpdate = {
            // EmitterState's "Loop Duration" is gated behind the Loop Behavior static switch, which
            // needs enum values -- Phase 2. Left at its defaults here, which loop infinitely.
            EmitterState();
            SpawnBurst_Instantaneous(SpawnCount = 24, SpawnTime = 0.0);
        }

        ParticleSpawn = {
            #Region "Initial state"
            // No InitializeParticle here on purpose: the current V2 module gates its value inputs
            // behind mode enums, and this file is deliberately restricted to the Phase 1 feature
            // set -- module calls with literal inputs and nothing else. NS_ToonHitSpark.dfs shows
            // the full form.
            SystemLocation(Offset = (0, 0, 0));
            #EndRegion
        }

        ParticleUpdate = {
            GravityForce(Gravity = (0, 0, -680));
            SolveForcesAndVelocity();
        }

        SpriteRenderer Core
        {
        }
    }
}
