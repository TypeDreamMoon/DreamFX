+void UNiagaraExternalEditUtilities::ClearScriptStack(const FNiagaraExt_StackItemReference& ScriptRef, FNiagaraExternalEditContext& Context)
+{
+	UNiagaraSystem* System = ScriptRef.GetSystem(Context);
+	UNiagaraStackScriptItemGroup* ScriptItem = ScriptRef.GetScript(Context);
+	if (System == nullptr || ScriptItem == nullptr)
+	{
+		return;
+	}
+
+	UNiagaraNodeOutput* OutputNode = ScriptItem->GetScriptOutputNode();
+	if (OutputNode == nullptr)
+	{
+		return;
+	}
+
+	// Read the module list from the graph rather than from the stack entries: the entries are what
+	// the refresh at the end rebuilds, and walking them while removing would be walking a list that
+	// is being invalidated underneath.
+	TArray<UNiagaraNodeFunctionCall*> ModuleNodes;
+	FNiagaraStackGraphUtilities::GetOrderedModuleNodes(*OutputNode, ModuleNodes);
+	if (ModuleNodes.Num() == 0)
+	{
+		return;
+	}
+
+	const FNiagaraEmitterHandle* Emitter = ScriptRef.GetEmitter(Context, /*bRequired=*/false);
+	const FGuid EmitterId = Emitter != nullptr ? Emitter->GetId() : FGuid();
+
+	const FScopedTransaction Transaction(LOCTEXT("ExternalClearScriptStack", "External System Clear Script Stack"));
+	System->Modify();
+
+	// Back to front: removal reindexes what is left, and the graph nodes are addressed directly here
+	// so the order only matters for the same reason it does in an ordinary loop.
+	TArray<TWeakObjectPtr<UNiagaraNodeInput>> RemovedInputNodes;
+	for (int32 Index = ModuleNodes.Num() - 1; Index >= 0; --Index)
+	{
+		if (ModuleNodes[Index] != nullptr)
+		{
+			FNiagaraStackGraphUtilities::RemoveModuleFromStack(*System, EmitterId, *ModuleNodes[Index], RemovedInputNodes);
+		}
+	}
+
+	ScriptItem->RefreshChildren();
+
+	FPropertyChangedEvent PropertyChangedEvent(nullptr, EPropertyChangeType::ValueSet);
+	System->PostEditChangeProperty(PropertyChangedEvent);
+}
