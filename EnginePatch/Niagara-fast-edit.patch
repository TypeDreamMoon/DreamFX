+	/** MoonEngine: the emitter's own parameter graph, where its parameter defaults live. */
+	UNiagaraGraph* GetEmitterGraph(const FNiagaraEmitterHandle& Emitter)
+	{
+		FNiagaraEmitterHandle& MutableHandle = const_cast<FNiagaraEmitterHandle&>(Emitter);
+		const FVersionedNiagaraEmitterData* Data = MutableHandle.GetEmitterData();
+		if (Data == nullptr)
