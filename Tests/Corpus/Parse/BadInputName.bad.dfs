// Negative case for the Phase 1 acceptance criterion: a mistyped module input name must be reported
// with the line and column of the argument itself, not of the module or the file.
//
// EXPECT DFX3003 (11,17)
System(Name="Corpus/NS_BadInputName", Root="Plugin.DreamFX")
{
    Emitter Sparks
    {
        ParticleUpdate = {
            GravityForce(
                Gravty = (0, 0, -980)
            );
        }
    }
}
