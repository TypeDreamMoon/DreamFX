# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Binary Files
Binaries/*

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

.obsidian/*

# Plans are local working notes and stay out of the repository; Docs/ ships with the plugin.
Plan/

# Measurement reports -- round trips, performance rounds, L3 runs, coverage sweeps. They are dated
# records of what a particular build measured on a particular machine, useful while the work is in
# flight and misleading afterwards: half of them were superseded within a day, and one of them
# argued for a bug that turned out not to exist. Docs/ carries what stays true.
Reports/

# Generated Niagara assets. Design principle 1: .uasset is a build product, the .dfs is the source.
# Rebuild them with: pwsh -File .skill/dfx.ps1 build -All -Force
Content/Samples/

# Assets the corpus suites build from Tests/Corpus fixtures. Recreated by every `dfx corpus` run.
Content/Corpus/

# Module and dynamic input assets, built from DFX/Modules/*.dfm by the same rule as the samples.
Content/Modules/

# Mirrors of this plugin's own assets. `decompile-all` walks every Niagara system it can see, which
# includes the ones DreamFX generated, and a plugin-rooted export mirrors into the plugin's Content.
# Build products of build products -- doubly not source.
Content/Decompiled/
