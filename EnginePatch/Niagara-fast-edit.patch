+void UNiagaraExternalEditUtilities::GetEmitterParameterDefaults(const FNiagaraExt_StackItemReference& EmitterRef, TArray<FNiagaraExt_ParameterDefault>& OutDefaults, FNiagaraExternalEditContext& Context)
+{
+	const FNiagaraEmitterHandle* Emitter = EmitterRef.GetEmitter(Context);
+	if (Emitter == nullptr)
+	{
+		return;
+	}
+
+	UNiagaraGraph* Graph = GetEmitterGraph(*Emitter);
+	if (Graph == nullptr)
+	{
+		Context.Error(NSLOCTEXT("NiagaraExternalEdit", "ParameterDefaults_NoGraph",
+			"Emitter has no parameter graph, so its parameter defaults cannot be read."));
+		return;
+	}
+
+	// GetAllVariables and GetDefaultMode rather than GetAllMetaData: a graph keeps parameters in two
+	// stores -- UNiagaraScriptVariable objects and the newer FNiagaraScriptVariableData structs --
+	// and GetAllMetaData only sees the first. Reading just that store found nothing at all on a
+	// loaded asset, which looked exactly like "this asset has no defaults".
+	// Reading the reference map first is load-bearing, not decorative: it is what rebuilds the
+	// graph's parameter store, and a graph that has only been loaded reports zero variables until
+	// it runs.
+	Graph->GetParameterReferenceMap();
+
+	TArray<FNiagaraVariable> Variables;
+	Graph->GetAllVariables(Variables);
+
+	UE_CLOG(UE_LOG_ACTIVE(LogNiagaraEditor, Verbose), LogNiagaraEditor, Verbose,
+		TEXT("PARAMDEFAULTS emitter '%s': graph has %d variable(s)"),
+		*Emitter->GetName().ToString(), Variables.Num());
+
+	for (const FNiagaraVariable& Variable : Variables)
+	{
+		FNiagaraScriptVariableBinding Binding;
+		const TOptional<ENiagaraDefaultMode> Mode = Graph->GetDefaultMode(Variable, &Binding);
+
+		// FailIfPreviouslyNotSet is what a parameter gets when nobody chose, so reporting it would
+		// make every read look like it carried an authored decision.
+		if (!Mode.IsSet() || *Mode == ENiagaraDefaultMode::FailIfPreviouslyNotSet)
+		{
+			continue;
+		}
+
+		FNiagaraExt_ParameterDefault& Entry = OutDefaults.AddDefaulted_GetRef();
+		Entry.Variable.Name = Variable.GetName();
+		Entry.Variable.Type = Variable.GetType();
+		Entry.Mode = *Mode;
+		Entry.Binding = Binding.GetName();
+
+		if (*Mode == ENiagaraDefaultMode::Value)
+		{
+			// GetDefaultMode reads both stores; the value is only reachable through the object one,
+			// which is private in the other. A caller that gets a mode with no value knows the
+			// default exists and that this API could not hand it over, which beats reporting neither.
+			if (const UNiagaraScriptVariable* ScriptVariable = Graph->GetScriptVariable(Variable))
+			{
+				Entry.Value.Set(Variable.GetType(), ScriptVariable->GetDefaultValueVariant());
+			}
+		}
+	}
+}
+
+void UNiagaraExternalEditUtilities::SetEmitterParameterDefault(const FNiagaraExt_StackItemReference& EmitterRef, const FNiagaraExt_ParameterDefault& InDefault, FNiagaraExternalEditContext& Context)
+{
+	const FNiagaraEmitterHandle* Emitter = EmitterRef.GetEmitter(Context);
+	if (Emitter == nullptr)
+	{
+		return;
+	}
+
+	UNiagaraGraph* Graph = GetEmitterGraph(*Emitter);
+	if (Graph == nullptr)
+	{
+		Context.Error(NSLOCTEXT("NiagaraExternalEdit", "ParameterDefaults_NoGraphForSet",
+			"Emitter has no parameter graph, so a parameter default cannot be set on it."));
+		return;
+	}
+
+	const FNiagaraVariable Parameter(InDefault.Variable.Type, InDefault.Variable.Name);
+	UNiagaraScriptVariable* ScriptVariable = Graph->GetScriptVariable(Parameter);
+	if (ScriptVariable == nullptr)
+	{
+		// A parameter only read by a module link has no entry of its own until something asks for
+		// one, which is exactly the case this exists to fix.
+		ScriptVariable = Graph->AddParameter(Parameter);
+	}
+	if (ScriptVariable == nullptr)
+	{
+		Context.Error(FText::Format(
+			NSLOCTEXT("NiagaraExternalEdit", "ParameterDefaults_AddFailed",
+				"Could not create a graph parameter for '{0}' to hold its default."),
+			FText::FromName(InDefault.Variable.Name)));
+		return;
+	}
+
+	const FScopedTransaction Transaction(LOCTEXT("ExternalSetParameterDefault", "External System Set Parameter Default"));
+	ScriptVariable->Modify();
+	ScriptVariable->DefaultMode = InDefault.Mode;
+
+	if (InDefault.Mode == ENiagaraDefaultMode::Binding)
+	{
+		ScriptVariable->DefaultBinding.SetName(InDefault.Binding);
+	}
+	else if (InDefault.Mode == ENiagaraDefaultMode::Value && InDefault.Value.IsValid())
+	{
+		FNiagaraVariant Variant;
+		InDefault.Value.Get(Variant, Context);
+
+		// SetDefaultValueData allocates from ScriptVariable->Variable's size before copying, so that
+		// has to be the right variable first. The variant also has to be carrying plain bytes: an
+		// object or data interface default has no byte form to store here.
+		if (Variant.GetMode() == ENiagaraVariantMode::Bytes
+			&& Variant.GetNumBytes() == Parameter.GetType().GetSize())
+		{
+			ScriptVariable->Variable = Parameter;
+			ScriptVariable->SetDefaultValueData(Variant.GetBytes());
+		}
+		else
+		{
+			Context.Error(FText::Format(
+				NSLOCTEXT("NiagaraExternalEdit", "ParameterDefaults_ValueUnsupported",
+					"Default value for '{0}' is not plain data, so it cannot be stored as a parameter default."),
+				FText::FromName(InDefault.Variable.Name)));
+			return;
+		}
+	}
+
+	// Three steps, and all three are needed. PostEditChange settles the object; ScriptVariableChanged
+	// is what the details panel calls after the same edit, and is what pushes the new mode out to the
+	// map-get nodes that read the parameter -- without it the value reads back correctly and the
+	// compile still fails, because the pin the mode asks for was never built.
+	ScriptVariable->PostEditChange();
+	Graph->ScriptVariableChanged(Parameter);
+	Graph->NotifyGraphNeedsRecompile();
+}
+
+void UNiagaraExternalEditUtilities::CleanUpStaleEmitterParameters(const FNiagaraExt_StackItemReference& EmitterRef, FNiagaraExternalEditContext& Context)
+{
+	const FNiagaraEmitterHandle* Emitter = EmitterRef.GetEmitter(Context);
+	if (Emitter == nullptr)
+	{
+		return;
+	}
+
+	FVersionedNiagaraEmitter Instance = const_cast<FNiagaraEmitterHandle*>(Emitter)->GetInstance();
+	if (Instance.Emitter == nullptr || Instance.GetEmitterData() == nullptr)
+	{
+		Context.Error(NSLOCTEXT("NiagaraExternalEdit", "CleanUpStale_NoEmitterData",
+			"Emitter has no data, so its stale parameters cannot be cleaned up."));
+		return;
+	}
+
+	const FScopedTransaction Transaction(LOCTEXT("ExternalCleanUpStaleParameters", "External System Clean Up Stale Parameters"));
+	Instance.Emitter->Modify();
+
+	// Hygiene, not a fix for anything measured. It drops the constants of modules that are no longer
+	// in the stack, which is what the merge manager does after a merge for the same reason.
+	//
+	// It does NOT close the in-place-vs-fresh gap, and emptying the store outright does not either:
+	// both were tried on N_MagicRuneCast_2 and its rebuilt mirror still carries 18 constants that a
+	// fresh-path build does not, with MainRune still emitting nothing. Those 18 belong to modules
+	// that *are* in the stack (`SubUVAnimation.Start Frame Offset` and friends) and survive an empty
+	// store, so the rebuild re-creates them -- they are produced, not left behind, and whatever
+	// produces them is still unidentified.
+	FNiagaraStackGraphUtilities::CleanUpStaleRapidIterationParameters(Instance);
+}
