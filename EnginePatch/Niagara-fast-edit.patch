+//////////////////////////////////////////////////////////////////////////
+// MoonEngine: accumulating step stats for the external-edit write path
+
+namespace
+{
+	TMap<FName, FNiagaraExternalEditStepStats::FStep> GMoonStepStats;
+
+	/** Accumulates the enclosing scope into one FNiagaraExternalEditStepStats row. */
+	struct FMoonScopedStep
+	{
+		FName Name;
+		double Start;
+		explicit FMoonScopedStep(FName InName) : Name(InName), Start(FPlatformTime::Seconds()) {}
+		~FMoonScopedStep() { FNiagaraExternalEditStepStats::Add(Name, FPlatformTime::Seconds() - Start); }
+	};
+}
+
+void FNiagaraExternalEditStepStats::Add(FName Step, double Seconds)
+{
+	FStep& Entry = GMoonStepStats.FindOrAdd(Step);
+	Entry.Seconds += Seconds;
+	++Entry.Count;
+}
+
+void FNiagaraExternalEditStepStats::Reset()
+{
+	GMoonStepStats.Reset();
+}
+
+void FNiagaraExternalEditStepStats::BuildReport(TArray<FString>& OutLines)
+{
+	TArray<TPair<FName, FStep>> Sorted;
+	for (const TPair<FName, FStep>& Entry : GMoonStepStats)
+	{
+		Sorted.Add(Entry);
+	}
+	Sorted.Sort([](const TPair<FName, FStep>& A, const TPair<FName, FStep>& B)
+	{
+		return A.Value.Seconds > B.Value.Seconds;
+	});
+
+	for (const TPair<FName, FStep>& Entry : Sorted)
+	{
+		OutLines.Add(FString::Printf(TEXT("%9.2f s  %7lld x  %8.2f ms each  %s"),
+			Entry.Value.Seconds,
+			Entry.Value.Count,
+			Entry.Value.Count > 0 ? (Entry.Value.Seconds * 1000.0 / Entry.Value.Count) : 0.0,
+			*Entry.Key.ToString()));
+	}
+}
