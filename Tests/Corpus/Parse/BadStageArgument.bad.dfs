// A Stage header takes exactly Iteration, DataInterface, NumIterations, ExecuteBehavior and
// Enabled; anything else must be named as unknown rather than skipped, because a dropped argument
// is a stage that quietly runs with different properties than the source says. (This fixture once
// used ExecuteBehavior as its unknown -- then ExecuteBehavior became real syntax and the negative
// fixture silently passed. Frequency is nobody's stage property.)
// EXPECT DFX2026
System(Name="Corpus/NS_BadStageArgument", Root="Plugin.DreamFX")
{
    Emitter Motes
    {
        Settings = { SimTarget = GPU; }

        Stage Settle(Frequency = 3) = {
            ScaleColor();
        }
    }
}
