System(Name="Corpus/NS_DynamicMeshBadSettings", Root="Plugin.DreamFX")
{
    DynamicMesh Sheet
    {
        Settings = {
            TexCoords = 9;
            Normals   = Smooth;
            Bounds    = box(100, 0, 0, -100, 10, 10);
            Shading   = 1;
        }
        Patch Body = Grid(9, 9) { }
    }
}
