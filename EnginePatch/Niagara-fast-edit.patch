+	/**
+	 * MoonEngine: records that a compile is owed without launching one.
+	 *
+	 * For a caller making many edits before it wants a result. RequestCompile aborts whatever is
+	 * still queued and launches again, so calling it per edit means every launch but the last is
+	 * thrown away -- 260 of them, 8.3 s, on one text-authored system. The debt is honoured by
+	 * WaitForCompilationComplete and PollForCompilationComplete, both of which already begin by
+	 * asking NeedsRequestCompile(). Never downgrades a stronger pending status.
+	 */
+	void DeferRequestCompile()
+	{
+		if (RequestCompileStatus == ERequestCompileStatus::None)
+		{
+			RequestCompileStatus = ERequestCompileStatus::RequestPending;
+		}
+	}
+
+	/**
+	 * MoonEngine: while set, RequestCompile records the debt (see DeferRequestCompile) and launches
+	 * nothing.
+	 *
+	 * For an external batch edit whose intermediate states are not worth compiling. The guarded
+	 * launch sites (RefreshAll's compile, auto-compile) already stand down while a debt or an active
+	 * compilation is outstanding; this catches the unguarded ones -- parameter renames, emitter
+	 * change notifications, and a view model construction that begins by paying the on-demand debt
+	 * of a freshly loaded system. Whoever ends the batch pays once: any explicit RequestCompile, or
+	 * WaitForCompilationComplete, which begins by honouring the debt.
+	 */
+	void SetSuppressCompileRequests(bool bSuppress) { bSuppressCompileRequests = bSuppress; }
